# Copie este archivo como .env y llene los valores. NUNCA suba .env al repo.

# --- Mosquitto local (mismo usuario/clave que MQTT_USUARIO/MQTT_CLAVE del .ino)
LOCAL_HOST=localhost
LOCAL_PORT=1883
LOCAL_USER=aeris
LOCAL_PASS=<CLAVE_MQTT>

# --- Ubidots (enlace cifrado con TLS por defecto, puerto 8883)
UBIDOTS_TOKEN=<TOKEN_UBIDOTS>
UBIDOTS_DEVICE=aeris
UBIDOTS_TLS=1
UBIDOTS_DEVICE_IA=aeris-ia
# Plan STEM: 10 variables/dispositivo, ~4000 dots/dia, ~30 dots/min.
# 300 s -> ~3500 dots/dia entre los dos dispositivos. No baje de 300 salvo en la demo.
UBIDOTS_INTERVALO_S=300
# Maximo 9 aqui (la 10a es el switch "alarma")
UBIDOTS_VARIABLES=distancia,temperatura,humedad,presion,lux,evaporacion,score_riesgo,alarma_nivel

# --- IA: groq (GPT-OSS 20B por API) | gemini (Google) | ollama (modelo local) | ninguno
IA_MODO=groq
OLLAMA_MODELO=llama3.2:1b
GROQ_KEY=<API_KEY_GROQ>
GEMINI_KEY=<API_KEY_GEMINI>
GEMINI_MODELO=gemini-2.5-flash
GROQ_MODELO=openai/gpt-oss-20b
IA_INTERVALO_S=300
IA_PRIMER_CICLO_S=60
# Ventana de analisis (s) y minimo de lecturas. Para la demo: IA_VENTANA_S=900, IA_INTERVALO_S=60
IA_VENTANA_S=10800
IA_MIN_LECTURAS=10
IA_UMBRAL_Z=3.0
# Piso de la desviacion de residuos (cm), ~resolucion del sensor
IA_SD_MIN_CM=0.5
# 1 = mandar la recomendacion a Telegram en cada ciclo (demo)
IA_NOTIFICAR_SIEMPRE=0

# --- Telegram
TELEGRAM_TOKEN=<TOKEN_BOT>
TELEGRAM_CHAT=<CHAT_ID>

# Distancia sensor-agua (cm) que significa tanque vacio
DISTANCIA_VACIO_CM=100
